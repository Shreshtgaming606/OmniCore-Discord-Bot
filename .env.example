DISCORD_TOKEN=DiscordBotTokenHere
MONGO_URI=mongodb:// or mongodb+srv:// url
OLLAMA_BASE_URL=http(s)://<addr>:<port>
OLLAMA_MODEL=OllamaModelHere
# Optional separate local Ollama endpoint for /imagegen (FLUX.2 Klein 4B).
# On Docker Desktop for Mac, use http://host.docker.internal:11435.
OMNICORE_IMAGEGEN_OLLAMA_URL=http://host.docker.internal:11435
# Optional host disk guard: mount an empty directory on the Mac's internal drive
# read-only at this path inside the bot container.
# OMNICORE_IMAGEGEN_HOST_DISK_PATH=/host-disk-check
# Optional controlled temporary directory; defaults to the system temp directory.
# OMNICORE_IMAGEGEN_TEMP_DIR=/tmp/omnicore-imagegen
START_SHARD=0
END_SHARD=4
TOTAL_SHARDS=5
OMNICORE_OWNER_1_ID=1109540816013234256
OMNICORE_OWNER_2_ID=1157083515486220429
# Generate once with: openssl rand -hex 32. Keep the same value across restarts.
OMNICORE_BYOK_MASTER_KEY_HEX=64HexCharactersStoredOnlyInRuntimeEnvironment
OMNICORE_DISCORD_CLIENT_ID=1521673931134603304
# Register https://discordbot.omnicoretech.org/connect/callback in Discord OAuth2.
OMNICORE_DISCORD_CLIENT_SECRET=SetOnlyInPrivateRuntimeEnvironment
