# REQUIRED. Create your own application at https://discord.com/developers/applications
DISCORD_TOKEN=
# REQUIRED. Use a local/private MongoDB server; see compose.example.yml.
MONGO_URI=mongodb://127.0.0.1:27017
# REQUIRED. Numeric Discord user ID(s), comma-separated. These operators can use
# private /voiceadmin controls and receive configured developer moderation alerts.
OMNICORE_OWNER_IDS=

# OPTIONAL. Defaults to OMNICORE_OWNER_IDS; controls legacy chat owner references.
# BOT_OWNERS=
# OPTIONAL. Numeric guild IDs allowed to use local voice and local image generation
# without individual operator approval. Empty by default.
# OMNICORE_VOICE_BUILTIN_GUILDS=
# OPTIONAL. One shard is sufficient for most self-hosted instances.
START_SHARD=0
END_SHARD=1
TOTAL_SHARDS=1
RUST_LOG=info

# OPTIONAL LOCAL AI. Leave OLLAMA_MODEL empty to run without Ollama.
# Local chat, local vision, and AutoMod classification need a reachable model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# OPTIONAL CLOUD AI /ai setup. Keep the master key stable across restarts.
# Generate privately: openssl rand -hex 32
OMNICORE_BYOK_MASTER_KEY_HEX=
# OMNICORE_DISCORD_CLIENT_ID=
# OMNICORE_DISCORD_CLIENT_SECRET=
# Your own HTTPS origin, without a trailing slash. Register its exact
# /connect/callback URL in the Discord Developer Portal.
# OMNICORE_PUBLIC_BASE_URL=

# OPTIONAL LOCAL IMAGE GENERATION. Requires an image-capable local Ollama
# service and the model documented in docs/IMAGEGEN.md.
# OMNICORE_IMAGEGEN_OLLAMA_URL=
# OMNICORE_IMAGEGEN_TEMP_DIR=
# OMNICORE_IMAGEGEN_HOST_DISK_PATH=

# OPTIONAL VOICE. Directory containing licensed Whisper/Piper model files.
# OMNICORE_VOICE_MODEL_DIR=
